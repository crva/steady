    "This backup has %lld habits. Merge keeps your habits and adds what's missing. Replace deletes your current habits first." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This backup has %lld habit. Merge keeps your habits and adds what's missing. Replace deletes your current habits first."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This backup has %lld habits. Merge keeps your habits and adds what's missing. Replace deletes your current habits first."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Cette sauvegarde contient %lld habitude. Fusionner conserve vos habitudes et ajoute ce qui manque. Remplacer supprime d'abord vos habitudes actuelles."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Cette sauvegarde contient %lld habitudes. Fusionner conserve vos habitudes et ajoute ce qui manque. Remplacer supprime d'abord vos habitudes actuelles."
                }
