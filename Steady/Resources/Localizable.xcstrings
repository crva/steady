    "All habits are copied to iCloud, then removed from the on-device store." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les habitudes sont copiées dans iCloud, puis retirées du stockage de l'appareil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los hábitos se copian a iCloud y luego se eliminan del almacenamiento del dispositivo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Gewohnheiten werden in iCloud kopiert und dann vom Gerätespeicher entfernt."
          }
        }
